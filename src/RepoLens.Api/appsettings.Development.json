{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "RepoLens": "Debug"
    }
  },

  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "repolens_dev"
  },

  "Auth": {
    "Jwt": {
      "SigningKey": "development-only-signing-key-change-me-0123456789abcdef"
    }
  },

  "Frontend": {
    "AuthCallbackUrl": "/api/v1/auth/dev/callback",
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },

  "Messaging": {
    "Provider": "InMemory"
  },

  "VectorSearch": {
    "Provider": "InApp"
  },

  "Repos": {
    "AutoSyncAfter": "00:30:00"
  }
}
