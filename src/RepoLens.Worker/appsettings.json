{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Azure.Messaging.ServiceBus": "Warning",
      "Azure.Core": "Warning",
      "Polly": "Warning"
    }
  },

  "Mongo": {
    "ConnectionString": "",
    "DatabaseName": "repolens"
  },

  "GitHub": {
    "MaxArchiveBytes": 314572800
  },

  "Messaging": {
    "Provider": "ServiceBus",
    "MaxDeliveryCount": 5,
    "MaxConcurrentMessages": 2,
    "ServiceBus": {
      "FullyQualifiedNamespace": "",
      "SummaryRequestsTopic": "summary-requests-topic",
      "SummaryRequestsSubscription": "summary-worker",
      "SummaryEventsTopic": "summary-events",
      "MaxAutoLockRenewalDuration": "00:30:00"
    }
  },

  "Ai": {
    "Provider": "AzureOpenAI",
    "Endpoint": "",
    "ChatModel": "gpt-5-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536
  },

  "VectorSearch": {
    "Provider": "CosmosVCore",
    "IndexName": "code_chunks_vector",
    "Dimensions": 1536
  },

  "Storage": {
    "GridFs": { "BucketName": "summary_pdfs" }
  },

  "Pdf": {
    "QuestPdfLicense": "Community"
  },

  "Summaries": {
    "Processing": { "StaleAfter": "00:15:00", "HeartbeatInterval": "00:00:30" },
    "Generation": {
      "MaxModules": 16,
      "MapConcurrency": 4,
      "MaxCharsPerModule": 40000
    }
  },

  "Indexing": {
    "MaxChunkChars": 1500,
    "OverlapChars": 150,
    "MaxChunks": 4000,
    "EmbeddingBatchSize": 64
  }
}
