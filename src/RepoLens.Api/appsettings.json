{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Mongo": {
    "ConnectionString": "",
    "DatabaseName": "repolens"
  },

  "GitHub": {
    "ClientId": "",
    "ClientSecret": "",
    "Scopes": [ "read:user", "user:email", "repo" ],
    "MaxRepositories": 2000,
    "MaxArchiveBytes": 314572800
  },

  "Auth": {
    "AuthCodeLifetime": "00:01:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "Jwt": {
      "Issuer": "repolens",
      "Audience": "repolens-api",
      "SigningKey": "",
      "AccessTokenLifetime": "01:00:00"
    }
  },

  "Frontend": {
    "AuthCallbackUrl": "",
    "AllowedOrigins": []
  },

  "Messaging": {
    "Provider": "ServiceBus",
    "MaxDeliveryCount": 5,
    "MaxConcurrentMessages": 2,
    "ServiceBus": {
      "FullyQualifiedNamespace": "",
      "SummaryRequestsTopic": "summary-requests-topic",
      "SummaryRequestsSubscription": "summary-worker",
      "SummaryEventsTopic": "summary-events"
    }
  },

  "Ai": {
    "Provider": "AzureOpenAI",
    "Endpoint": "",
    "ChatModel": "gpt-5-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536
  },

  "VectorSearch": {
    "Provider": "CosmosVCore",
    "IndexName": "code_chunks_vector",
    "Dimensions": 1536
  },

  "Storage": {
    "GridFs": { "BucketName": "summary_pdfs" }
  },

  "Pdf": {
    "QuestPdfLicense": "Community"
  },

  "Repos": {
    "AutoSyncAfter": "06:00:00"
  },

  "Summaries": {
    "Processing": { "StaleAfter": "00:15:00", "HeartbeatInterval": "00:00:30" },
    "Outbox": { "PollInterval": "00:00:10", "PublishGracePeriod": "00:00:15" }
  },

  "Questions": {
    "TopK": 8,
    "HistoryMessages": 6
  },

  "RateLimiting": {
    "GlobalPerMinute": 300,
    "SignInPerMinute": 20,
    "SummariesPerHour": 30,
    "QuestionsPerMinute": 20,
    "SyncsPerHour": 30
  }
}
